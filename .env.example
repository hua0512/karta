# Environment variables for integration tests.
# Tests read process env directly; export these values or source this file before running.

# Douyin cookie (from browser DevTools → Network → Request Headers → Cookie)
# Required for: cargo test -p karta-platforms --test douyin_need_ck -- --ignored
KARTA_TEST_DOUYIN_COOKIE=

# Bilibili cookie (from browser DevTools → Network → Request Headers → Cookie)
# Required for: cargo test -p karta-platforms --test bilibili_need_ck -- --ignored
KARTA_TEST_BILI_COOKIE=

# Instagram cookie (from browser DevTools → Network → Request Headers → Cookie)
# Required for: cargo test -p karta-platforms --test instagram_need_ck -- --ignored
KARTA_TEST_IG_COOKIE=
